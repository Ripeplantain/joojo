# Copy to .env.local and fill in real values. Never commit .env.local.

# Clerk — publishable key and routing config are safe for the browser.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk — server-only secret key. Never prefix this NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Sanity — project id and dataset name are not secret, safe for the browser.
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity — server-only read token (Viewer role). The dataset is private, so every
# server-side read goes through this token. Never prefix this NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
